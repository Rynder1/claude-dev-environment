# Per-environment generated compose files
envs/

# Secrets - SSH public keys copied per environment, any keys
secrets/
*.pem
*.key
authorized_keys
.env

# Local, site-specific overrides (internal hostnames, machine paths).
# The committed config/local.env.example is the documented template.
config/local.env

# Python bytecode cache
__pycache__/
*.pyc

# Claude Code local scratch (git worktrees, session state). Nothing here is meant
# to be committed; without this, tools like GitHub Desktop walk into the nested
# worktree checkouts and report every file in them as an untracked change.
.claude/
