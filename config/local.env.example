# ------------------------------------------------------------------------------
# Local overrides for claude-dev-environment.
#
# COPY this file to  config/local.env  (which is gitignored) and edit it. This keeps
# site-specific values - internal hostnames, machine paths, defaults - OUT of the
# committed repo. Every value is optional; the scripts fall back to a sane default
# when it is unset, so an empty/absent config still works.
# ------------------------------------------------------------------------------

# Domains automatically added to the egress allowlist when you create an environment
# with --firewall (comma / space separated). Put your internal package feed or infra
# hosts here so you don't have to pass --firewall-domains every time. Example:
#   FIREWALL_EXTRA_DOMAINS="proget.internal.example, nexus.internal.example"
FIREWALL_EXTRA_DOMAINS=""

# WSL distro name used by the dashboard's "root shell" button.
WSL_DISTRO="Ubuntu"

# Default port the dashboard listens on (127.0.0.1 only).
DASHBOARD_PORT="8787"
